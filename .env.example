# Datenbank (MySQL / MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=market_directory
DB_USER=root
DB_PASSWORD=changeme

# Basis-URL der Anwendung (fuer Stripe-Redirects)
APP_URL=http://localhost:8080

# Admin-Zugang (wird von bin/seed.php angelegt)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# Stripe (Testmodus-Keys aus dem Stripe-Dashboard, https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Preis fuer einen Markteintrag, in kleinster Waehrungseinheit (Cent)
LISTING_PRICE_AMOUNT=4900
LISTING_CURRENCY=eur
